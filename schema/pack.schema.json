{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mcqpack-1.0",
  "title": "mcqpack v1.0 pack.json",
  "type": "object",
  "required": ["format", "formatVersion", "id", "version", "title", "optionKeys", "questions"],
  "properties": {
    "format": { "const": "mcqpack" },
    "formatVersion": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$" },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "optionKeys": {
      "type": "array", "minItems": 2, "maxItems": 10, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 3 }
    },
    "timeLimitSec": { "type": "integer", "exclusiveMinimum": 0 },
    "overlays": { "type": "array", "items": { "type": "string" } },
    "questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" } }
  },
  "$defs": {
    "question": {
      "type": "object",
      "required": ["id", "type", "rev"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$" },
        "type": { "type": "string" },
        "rev": { "type": "integer", "minimum": 1 },
        "number": { "type": "integer" },
        "answer": { "type": "string" },
        "snapshot": { "type": "array", "items": { "$ref": "#/$defs/image" } },
        "stem": { "type": "array", "items": { "$ref": "#/$defs/block" } },
        "options": {
          "type": "array",
          "items": {
            "type": "object", "required": ["key", "blocks"],
            "properties": {
              "key": { "type": "string" },
              "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
            }
          }
        },
        "explanation": { "type": "string" },
        "topics": { "type": "array", "items": { "type": "string" } }
      }
    },
    "image": {
      "type": "object", "required": ["src"],
      "properties": {
        "src": { "type": "string" },
        "clip": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0 } }
      }
    },
    "block": {
      "type": "object", "required": ["type"],
      "properties": { "type": { "type": "string" } },
      "allOf": [
        { "if": { "properties": { "type": { "const": "text" } } }, "then": { "required": ["text"], "properties": { "text": { "type": "string" } } } },
        { "if": { "properties": { "type": { "const": "math" } } }, "then": { "required": ["tex"], "properties": { "tex": { "type": "string" }, "display": { "type": "boolean" } } } },
        { "if": { "properties": { "type": { "const": "fig" } } }, "then": { "$ref": "#/$defs/image", "required": ["src", "alt"], "properties": { "alt": { "type": "string", "minLength": 1 }, "provenance": { "enum": ["crop", "redraw"] } } } },
        { "if": { "properties": { "type": { "const": "table" } } }, "then": { "required": ["rows"], "properties": { "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }, "header": { "type": "boolean" } } } }
      ]
    }
  }
}
