# Copy to .env.local (ignored by git) for local testing, or set these in Cloudflare Pages environment
# variables for the deployed site. See docs/CLOUDFLARE_SETUP.md.
# Only these two PUBLIC values. Never put the service_role / secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Development only: use the in-browser mock backend even in a production build.
# VITE_BACKEND=mock
